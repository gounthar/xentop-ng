From df7e4e84e134d555f992e8fbd3268b9542ab9fa3 Mon Sep 17 00:00:00 2001
From: Olivier Lambert <olivier.lambert@vates.tech>
Date: Thu, 1 Oct 2026 08:04:01 +0200
Subject: [PATCH] xen/domctl: add XEN_DOMCTL_get_vcpu_runstate

A vCPU's runstate accounting (time spent running, runnable, blocked and
offline) is only available to the vCPU's own domain, through
VCPUOP_get_runstate_info or a registered runstate area.  The toolstack
can get running time from XEN_DOMCTL_getvcpuinfo, but has no way to see
how long a vCPU was runnable without being scheduled, i.e. waiting for a
physical CPU.  That "steal time" is the most direct measure of CPU
contention on a host, and monitoring tools in dom0 (xentop and friends)
cannot show it today.

Add XEN_DOMCTL_get_vcpu_runstate, which returns vcpu_runstate_get() for
one vCPU of the target domain: the current state, when it was entered,
and the time spent in each RUNSTATE_*, up to the time of the call.  Like
XEN_DOMCTL_getvcpuinfo it only reads scheduler accounting, so it is
handled the same way, right next to it, and covered by the same XSM
permission (domain getvcpuinfo).

This is the XCP-ng 4.17 backport.  XCP-ng's own whole-domain
XEN_DOMCTL_get_runstate_info (98) is unrelated and left alone; this
sub-op takes the next upstream number (91), unused in 4.17.

Adding a sub-op is a compatible change, so XEN_DOMCTL_INTERFACE_VERSION
is left alone.  Callers detect older hypervisors by the failure of the
call (ENOSYS without XSM).

Also add the libxenctrl wrapper xc_vcpu_get_runstate().

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 tools/include/xenctrl.h             | 11 +++++++++++
 tools/libs/ctrl/xc_domain.c         | 19 +++++++++++++++++++
 xen/common/domctl.c                 | 24 ++++++++++++++++++++++++
 xen/include/public/domctl.h         | 20 ++++++++++++++++++++
 xen/xsm/flask/hooks.c               |  1 +
 xen/xsm/flask/policy/access_vectors |  1 +
 6 files changed, 76 insertions(+)

diff --git a/tools/include/xenctrl.h b/tools/include/xenctrl.h
index bc6738d..25973f8 100644
--- a/tools/include/xenctrl.h
+++ b/tools/include/xenctrl.h
@@ -860,6 +860,17 @@ int xc_vcpu_getinfo(xc_interface *xch,
                     uint32_t vcpu,
                     xc_vcpuinfo_t *info);
 
+/*
+ * Time vCPU @vcpu of @domid has spent in each RUNSTATE_* so far (running,
+ * runnable i.e. waiting for a pCPU, blocked, offline).  Hypervisors without
+ * XEN_DOMCTL_get_vcpu_runstate fail it, usually with errno ENOSYS.
+ */
+typedef struct xen_domctl_vcpu_runstate xc_vcpu_runstate_t;
+int xc_vcpu_get_runstate(xc_interface *xch,
+                         uint32_t domid,
+                         uint32_t vcpu,
+                         xc_vcpu_runstate_t *info);
+
 long long xc_domain_get_cpu_usage(xc_interface *xch,
                                   uint32_t domid,
                                   int vcpu);
diff --git a/tools/libs/ctrl/xc_domain.c b/tools/libs/ctrl/xc_domain.c
index 951ab2a..0bb0318 100644
--- a/tools/libs/ctrl/xc_domain.c
+++ b/tools/libs/ctrl/xc_domain.c
@@ -1339,6 +1339,25 @@ int xc_vcpu_getinfo(xc_interface *xch,
     return rc;
 }
 
+int xc_vcpu_get_runstate(xc_interface *xch,
+                         uint32_t domid,
+                         uint32_t vcpu,
+                         xc_vcpu_runstate_t *info)
+{
+    int rc;
+    struct xen_domctl domctl = {
+        .cmd = XEN_DOMCTL_get_vcpu_runstate,
+        .domain = domid,
+        .u.vcpu_runstate.vcpu = vcpu,
+    };
+
+    rc = do_domctl(xch, &domctl);
+    if ( rc == 0 )
+        *info = domctl.u.vcpu_runstate;
+
+    return rc;
+}
+
 int xc_get_runstate_info(xc_interface *xch, uint32_t domid, xc_runstate_info_t *info)
 {
     /* The main caller is statically linked.  Careful with the ABI. */
diff --git a/xen/common/domctl.c b/xen/common/domctl.c
index 7471801..02acf52 100644
--- a/xen/common/domctl.c
+++ b/xen/common/domctl.c
@@ -848,6 +848,30 @@ long do_domctl(XEN_GUEST_HANDLE_PARAM(xen_domctl_t) u_domctl)
         break;
     }
 
+    case XEN_DOMCTL_get_vcpu_runstate:
+    {
+        struct vcpu *v;
+        struct vcpu_runstate_info runstate;
+        unsigned int i;
+
+        ret = -ENOENT;
+        if ( (v = domain_vcpu(d, op->u.vcpu_runstate.vcpu)) == NULL )
+            break;
+
+        vcpu_runstate_get(v, &runstate);
+
+        BUILD_BUG_ON(ARRAY_SIZE(op->u.vcpu_runstate.time) !=
+                     ARRAY_SIZE(runstate.time));
+        op->u.vcpu_runstate.state = runstate.state;
+        op->u.vcpu_runstate.state_entry_time = runstate.state_entry_time;
+        for ( i = 0; i < ARRAY_SIZE(runstate.time); i++ )
+            op->u.vcpu_runstate.time[i] = runstate.time[i];
+
+        ret = 0;
+        copyback = 1;
+        break;
+    }
+
     case XEN_DOMCTL_max_mem:
     {
         uint64_t new_max = op->u.max_mem.max_memkb >> (PAGE_SHIFT - 10);
diff --git a/xen/include/public/domctl.h b/xen/include/public/domctl.h
index e9022dd..2f635e1 100644
--- a/xen/include/public/domctl.h
+++ b/xen/include/public/domctl.h
@@ -293,6 +293,24 @@ struct xen_domctl_getvcpuinfo {
     uint32_t cpu;                     /* current mapping   */
 };
 
+/*
+ * XEN_DOMCTL_get_vcpu_runstate
+ *
+ * Runstate accounting of one vCPU of the target domain: the data
+ * VCPUOP_get_runstate_info returns to the vCPU's own domain, brought up to
+ * the time of the call.  Lets a toolstack tell time a vCPU spent waiting for
+ * a physical CPU (RUNSTATE_runnable, i.e. steal time) from time spent idle.
+ */
+struct xen_domctl_vcpu_runstate {
+    /* IN variables. */
+    uint32_t vcpu;
+    /* OUT variables. */
+    uint32_t state;                    /* current RUNSTATE_* */
+    uint64_aligned_t state_entry_time; /* when it was entered (system time, ns) */
+    uint64_aligned_t time[4];          /* ns spent in each RUNSTATE_* */
+};
+typedef struct xen_domctl_vcpu_runstate xen_domctl_vcpu_runstate_t;
+
 
 /* Get/set the NUMA node(s) with which the guest has affinity with. */
 /* XEN_DOMCTL_setnodeaffinity */
@@ -1323,6 +1341,7 @@ struct xen_domctl {
 #define XEN_DOMCTL_vmtrace_op                    84
 #define XEN_DOMCTL_get_paging_mempool_size       85
 #define XEN_DOMCTL_set_paging_mempool_size       86
+#define XEN_DOMCTL_get_vcpu_runstate             91
 #define XEN_DOMCTL_get_runstate_info             98
 #define XEN_DOMCTL_gdbsx_guestmemio            1000
 #define XEN_DOMCTL_gdbsx_pausevcpu             1001
@@ -1387,6 +1406,7 @@ struct xen_domctl {
         struct xen_domctl_vuart_op          vuart_op;
         struct xen_domctl_vmtrace_op        vmtrace_op;
         struct xen_domctl_paging_mempool    paging_mempool;
+        struct xen_domctl_vcpu_runstate     vcpu_runstate;
         uint8_t                             pad[128];
     } u;
 };
diff --git a/xen/xsm/flask/hooks.c b/xen/xsm/flask/hooks.c
index 33fedd4..9a9a6a9 100644
--- a/xen/xsm/flask/hooks.c
+++ b/xen/xsm/flask/hooks.c
@@ -749,6 +749,7 @@ static int cf_check flask_domctl(struct domain *d, struct xen_domctl *op)
         return current_has_perm(d, SECCLASS_DOMAIN, DOMAIN__GETVCPUCONTEXT);
 
     case XEN_DOMCTL_getvcpuinfo:
+    case XEN_DOMCTL_get_vcpu_runstate:
         return current_has_perm(d, SECCLASS_DOMAIN, DOMAIN__GETVCPUINFO);
 
     case XEN_DOMCTL_settimeoffset:
diff --git a/xen/xsm/flask/policy/access_vectors b/xen/xsm/flask/policy/access_vectors
index 48bc550..e851126 100644
--- a/xen/xsm/flask/policy/access_vectors
+++ b/xen/xsm/flask/policy/access_vectors
@@ -143,6 +143,7 @@ class domain
 # XEN_DOMCTL_getdomaininfo, XEN_SYSCTL_getdomaininfolist
     getdomaininfo
 # XEN_DOMCTL_getvcpuinfo
+# XEN_DOMCTL_get_vcpu_runstate
     getvcpuinfo
 # XEN_DOMCTL_getvcpucontext
 # XEN_DOMCTL_get_ext_vcpucontext
-- 
2.55.0

